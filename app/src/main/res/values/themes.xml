<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns colour, type and shape. This theme only supplies the window
         frame (no action bar, matching background) so launch is not jarring. -->
    <style name="Theme.Bloom" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bloom_background</item>
    </style>
</resources>
